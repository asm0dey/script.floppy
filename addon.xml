<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="script.floppy" name="Floppy" version="0.1.0" provider-name="asm0dey">
  <requires>
    <import addon="xbmc.python" version="3.0.1"/>
  </requires>
  <extension point="xbmc.service" library="service.py"/>
  <extension point="xbmc.python.script" library="default.py">
    <provides>executable</provides>
  </extension>
  <extension point="kodi.context.item">
    <menu id="kodi.core.main">
      <item library="context.py">
        <label>30040</label>
        <visible>(String.IsEqual(ListItem.DBType,movie) | String.IsEqual(ListItem.DBType,episode)) + !Integer.IsGreater(ListItem.PlayCount,0)</visible>
      </item>
      <item library="context.py">
        <label>30041</label>
        <visible>(String.IsEqual(ListItem.DBType,movie) | String.IsEqual(ListItem.DBType,episode)) + Integer.IsGreater(ListItem.PlayCount,0)</visible>
      </item>
      <item library="context.py">
        <label>30042</label>
        <visible>String.IsEqual(ListItem.DBType,season) | String.IsEqual(ListItem.DBType,tvshow)</visible>
      </item>
    </menu>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Sync Kodi watch state with a Floppy server</summary>
    <description lang="en_GB">Syncs watched state and resume points between Kodi and a self-hosted Floppy media tracker.</description>
    <platform>all</platform>
    <license>GPL-2.0-or-later</license>
    <source>https://github.com/asm0dey/kodi-floppy-addon</source>
  </extension>
</addon>
